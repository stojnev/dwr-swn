#!/bin/bash
set -o pipefail
DIR=/run/cdmem
WORK=/run/cdplay-work
DEV=/dev/sr0
OPTS="-q -Z"      # remove -Z for verified (slower, safer) reads
HEAD_MIN=4500     # minimum head length in sectors (60 s)
SS=2352           # bytes per sector
TAG=/usr/local/bin/cdtag

log() { echo "$(date +%T.%N | cut -c1-12) $*"; }
msf() { local f=$1; printf "%d:%02d.%02d" $((f/4500)) $(((f%4500)/75)) $((f%75)); }
add() { mpc update --wait >/dev/null; mpc add "$1" >/dev/null; }
# raw audio from the disc into FILE at a byte offset
read_into() {
  cdparanoia $OPTS -r -d $DEV "$1" - | \
    dd of="$2" bs=1M iflag=fullblock oflag=seek_bytes seek=$3 conv=notrunc status=none
}

mpc stop >/dev/null; mpc clear >/dev/null
mountpoint -q $DIR || mount -t tmpfs -o size=@RAM_MB@m tmpfs $DIR
rm -f $DIR/*
mkdir -p $WORK; rm -f $WORK/*
log "start"

TOC=$(cdparanoia -Q -d $DEV 2>&1)
N=$(echo "$TOC" | grep -cE '^ *[0-9]+\.')
L1=$(echo "$TOC" | awk '$1=="1." {print $2}')
log "toc: $N tracks, track 1 = $L1 sectors"
echo "$N" > "$WORK/ntracks"

# title lookup in parallel with the first read, at most 8 s
echo "$TOC" | timeout 8 $TAG lookup > $WORK/meta.json 2>/dev/null &
LP=$!

# track 1: head first (read raw), tail after playback has started
H=$(( L1/4 > HEAD_MIN ? L1/4 : HEAD_MIN ))
if [ "$L1" -le "$H" ]; then H=$L1; SPAN="1"; else SPAN="1[0:00]-1[$(msf $((H-1)))]"; fi
cdparanoia $OPTS -r -d $DEV "$SPAN" $WORK/head.raw || { log "head read failed"; exit 1; }
wait $LP
if grep -q '"album"' $WORK/meta.json 2>/dev/null; then log "lookup: found"; $TAG cover $WORK/meta.json $WORK/cover.jpg >/dev/null 2>&1 & else log "lookup: none (using track numbers)"; fi

F=$DIR/track01.wav
OFF=$($TAG header $WORK/meta.json 1 $L1 $F.part)
dd if=$WORK/head.raw of=$F.part bs=1M oflag=seek_bytes seek=$OFF conv=notrunc status=none
rm -f $WORK/head.raw
mv $F.part $F
add track01.wav; mpc play >/dev/null; log "playing"
if [ "$H" -lt "$L1" ]; then
  read_into "1[$(msf $H)]-1" $F $((OFF + H*SS)) || log "track 1 tail read failed"
  log "track 1 tail ready"
fi

for i in $(seq 2 $N); do
  S=$(echo "$TOC" | awk -v t="$i." '$1==t {print $2}')
  f=$(printf "%s/track%02d.wav" $DIR $i)
  OFF=$($TAG header $WORK/meta.json $i $S $f.part)
  if read_into "$i" $f.part $OFF; then
    mv $f.part $f; add "$(basename $f)"; log "track $i ready"
  else
    rm -f $f.part; log "track $i read FAILED"
  fi
done
log "done"
exit 0
