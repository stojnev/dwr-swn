#!/usr/bin/env python3
import subprocess, time
from signal import pause, signal, SIGCHLD, SIG_IGN
from gpiozero import Button

PIN = @BUTTON_GPIO@          # BCM GPIO number (17 = physical pin 11, ground on physical pin 9)
LOCKOUT = 5       # seconds to ignore further presses after an eject

signal(SIGCHLD, SIG_IGN)   # no zombie processes
last = 0.0


def eject():
    global last
    now = time.monotonic()
    if now - last < LOCKOUT:
        return
    last = now
    subprocess.Popen(["sudo", "-n", "/usr/local/bin/cdeject"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


button = Button(PIN, pull_up=True, bounce_time=0.05)
button.when_pressed = eject
pause()
