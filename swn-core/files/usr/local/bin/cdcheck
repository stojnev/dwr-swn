#!/bin/bash
# Checks every part of the player. Usage: cdcheck   (run with sudo for the full set)
[ -r /etc/swn-core.conf ] && . /etc/swn-core.conf
: "${CD_USER:=swn}" "${AUDIO_CARD:=D20}" "${RAM_MB:=900}" "${BUTTON_GPIO:=17}"
FAIL=0; WARN=0
ok()   { printf '  PASS  %s\n' "$*"; }
bad()  { printf '  FAIL  %s\n' "$*"; FAIL=$((FAIL+1)); }
warn() { printf '  WARN  %s\n' "$*"; WARN=$((WARN+1)); }
chk()  { local msg=$1; shift; if "$@" >/dev/null 2>&1; then ok "$msg"; else bad "$msg"; fi; }

echo "Settings: user=$CD_USER remote=${REMOTE_ADDR:-?} card=$AUDIO_CARD gpio=$BUTTON_GPIO ram=${RAM_MB}MB"

echo; echo "Programs"
for c in mpd mpc cdparanoia eject sg_raw bluetoothctl btmon aplay lsusb curl python3; do
    chk "command $c" command -v $c
done
for s in cdplay cdtag cdeject cdbutton cdremote cdui cdverify cdcompare cdpair; do
    chk "/usr/local/bin/$s executable" test -x /usr/local/bin/$s
done
chk "python gpiozero importable" python3 -c 'import gpiozero'
chk "python lgpio importable"    python3 -c 'import lgpio'

echo; echo "Rules and permissions"
chk "udev: SuperDrive wake-up rule" grep -q 'sg_raw %N EA 00 00 00 00 00 01' /etc/udev/rules.d/99-superdrive.rules
chk "udev: disc-change rule starts cdplay" grep -q 'unit=cdplay' /etc/udev/rules.d/98-cdplay.rules
chk "sudoers file valid" visudo -cf /etc/sudoers.d/cdeject
if [ "$(id -u)" -eq 0 ]; then
    chk "$CD_USER may run cdeject without a password" sudo -n -l -U "$CD_USER" /usr/local/bin/cdeject
else
    warn "run with sudo to check the sudoers rule for $CD_USER"
fi
chk "user $CD_USER exists" id "$CD_USER"

echo; echo "Drive"
if lsusb 2>/dev/null | grep -qi '05ac:1500'; then ok "SuperDrive on USB (05ac:1500)"; else bad "SuperDrive not seen on USB"; fi
if [ -e /dev/sr0 ]; then ok "/dev/sr0 exists"; else warn "/dev/sr0 missing (drive asleep? unplug and replug it)"; fi
if lsusb 2>/dev/null | grep -qi '28d4:0008'; then ok "Audio Device on USB (28d4:0008)"; else warn "Audio Device USB ID 28d4:0008 not seen"; fi

echo; echo "RAM disk"
if mountpoint -q /run/cdmem; then
    ok "/run/cdmem is mounted"
    fs=$(findmnt -no FSTYPE /run/cdmem); [ "$fs" = tmpfs ] && ok "it is tmpfs (RAM)" || bad "it is $fs, not tmpfs - playback would not be from RAM"
    sz=$(findmnt -no SIZE -b /run/cdmem 2>/dev/null); want=$((RAM_MB*1024*1024))
    [ -n "$sz" ] && [ "$sz" -ge $((want-1048576)) ] && ok "size $((sz/1048576)) MB" || warn "size is ${sz:-?} bytes, expected about ${RAM_MB} MB"
else
    bad "/run/cdmem not mounted"
fi
chk "fstab line for /run/cdmem" grep -q '^tmpfs /run/cdmem tmpfs' /etc/fstab

echo; echo "MPD and audio"
chk "mpd.conf music_directory is /run/cdmem" grep -qE '^music_directory[[:space:]]+"/run/cdmem"' /etc/mpd.conf
chk "mpd.conf audio_buffer_size is 4096 (do not raise it)" grep -qE '^audio_buffer_size[[:space:]]+"4096"' /etc/mpd.conf
chk "mpd.conf has no state_file" bash -c '! grep -q "^state_file" /etc/mpd.conf'
chk "mpd.conf output uses card $AUDIO_CARD" grep -q "hw:CARD=$AUDIO_CARD,DEV=0" /etc/mpd.conf
if aplay -l 2>/dev/null | grep -q "card [0-9]*: $AUDIO_CARD "; then ok "ALSA card $AUDIO_CARD present"; else bad "ALSA card $AUDIO_CARD not present (aplay -l)"; fi
chk "mpd answers (mpc status)" mpc status
rate=$(grep -h 'rate:' /proc/asound/$AUDIO_CARD/pcm0p/sub0/hw_params 2>/dev/null)
[ -n "$rate" ] && ok "DAC currently open: $(tr '\n' ' ' < /proc/asound/$AUDIO_CARD/pcm0p/sub0/hw_params | cut -c1-70)" || echo "  info  DAC idle (hw_params shows while playing)"

echo; echo "Services"
for u in mpd bluetooth cdui cdbutton cdremote; do
    chk "service $u active" systemctl is-active --quiet $u
    chk "service $u enabled at boot" systemctl is-enabled --quiet $u
done
chk "cdui runs as $CD_USER" bash -c "systemctl show cdui -p User --value | grep -qx '$CD_USER'"
chk "cdui may bind port 80" grep -q CAP_NET_BIND_SERVICE /etc/systemd/system/cdui.service.d/port80.conf

echo; echo "Web page"
code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1/ 2>/dev/null)
[ "$code" = 200 ] && ok "page answers on port 80" || bad "page: HTTP $code"
code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1/api/status 2>/dev/null)
[ "$code" = 200 ] && ok "status API answers" || bad "status API: HTTP $code"
if [ -f /usr/local/share/cdui/idle.png ] || ls /usr/local/share/cdui/idle.* >/dev/null 2>&1; then ok "idle image present"; else warn "no idle image (page shows only the title; see README)"; fi

echo; echo "Remote"
if [ -n "${REMOTE_ADDR:-}" ]; then
    info=$(bluetoothctl info "$REMOTE_ADDR" 2>/dev/null)
    if echo "$info" | grep -q 'Paired: yes'; then
        ok "remote $REMOTE_ADDR is paired"
        echo "$info" | grep -q 'Trusted: yes' && ok "remote is trusted" || warn "remote not trusted (bluetoothctl trust $REMOTE_ADDR)"
        echo "$info" | grep -q 'Connected: yes' && ok "remote is connected" || warn "remote not connected right now (asleep - press a button)"
    else
        warn "remote $REMOTE_ADDR not paired yet - run: sudo cdpair"
    fi
fi
pgrep -x btmon >/dev/null && ok "btmon running (used by cdremote)" || warn "btmon not running (cdremote starts it)"

echo
if [ "$FAIL" -eq 0 ]; then echo "RESULT: all checks passed ($WARN warnings)"; else echo "RESULT: $FAIL check(s) FAILED ($WARN warnings)"; fi
[ "$FAIL" -eq 0 ]
