<script>
const $ = id => document.getElementById(id);
const PLAY = "M8 5v14l11-7z", PAUSE = "M6 19h4V5H6v14zm8-14v14h4V5h-4z";
let fails = 0, S = null, t0 = 0, dragging = false, dragFrac = 0, armed = false, armTimer = null;

const fmt = s => { s = Math.max(0, Math.floor(s || 0)); return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0"); };

async function act(name) {
  try { await fetch("/api/" + name, { method: "POST" }); } catch (e) {}
  poll();
}
async function poll() {
  try {
    const r = await fetch("/api/status", { cache: "no-store" });
    if (!r.ok) throw new Error("status " + r.status);
    S = await r.json(); t0 = performance.now(); fails = 0;
  } catch (e) { if (++fails >= 3) S = { offline: true }; }
  render();
}
function elapsedNow() {
  if (!S || S.elapsed == null) return 0;
  let e = S.elapsed + (S.state === "play" ? (performance.now() - t0) / 1000 : 0);
  if (S.duration) e = Math.min(e, S.duration);
  return e;
}
function render() {
  const idle = !S || S.offline || (S.state === "stop" && S.loaded === 0 && !S.loading);
  document.body.classList.toggle("idle", idle);
  let title = "", artist = "", album = "", meta = "", el = 0, du = 0, playing = false;
  if (!S) { title = "\u00a0"; }
  else if (S.offline) { title = "Offline"; }
  else if (S.state === "stop" && S.loaded === 0) { title = S.loading ? "Reading disc\u2026" : "No disc"; }
  else if (S.state === "stop") { title = "Stopped"; meta = "Press play"; }
  else {
    title = S.title; artist = S.artist; album = S.album;
    meta = (S.state === "pause" ? "Paused " : "Playing ") + S.track + " of " + S.total;
    el = elapsedNow(); du = S.duration || 0; playing = S.state === "play";
  }
  let loadTxt = "";
  if (S && !S.offline && S.pending) loadTxt = "Loading track " + S.pending + "\u2026";
  else if (S && !S.offline && S.loading && S.loaded > 0) loadTxt = "Loading " + S.loaded + " of " + S.total;
  let frac = du ? el / du : 0;
  if (dragging && du) { frac = dragFrac; el = frac * du; }
  const cv = $("cover");
  if (S && !S.offline && S.cover && S.loaded > 0) {
    const src = "/api/cover?v=" + S.cover;
    if (cv.getAttribute("src") !== src) cv.setAttribute("src", src);
    cv.hidden = false;
  } else { cv.hidden = true; }
  $("title").textContent = title || "\u00a0";
  $("artist").textContent = artist;
  $("album").textContent = album;
  const mEl = $("meta");
  mEl.textContent = meta + (meta && loadTxt ? " \u00b7 " : "");
  if (loadTxt) { const sp = document.createElement("span"); sp.className = "loading"; sp.textContent = loadTxt; mEl.appendChild(sp); }
  $("fill").style.width = (frac * 100).toFixed(2) + "%";
  $("el").textContent = fmt(el);
  $("du").textContent = fmt(du);
  $("playpath").setAttribute("d", playing ? PAUSE : PLAY);
}

$("play").onclick = () => act("toggle");
$("prev").onclick = () => act("prev");
$("next").onclick = () => act("next");
$("stop").onclick = () => act("stop");

const bar = $("bar");
const fracOf = e => { const r = $("rail").getBoundingClientRect(); return Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)); };
bar.addEventListener("pointerdown", e => {
  if (!S || !S.duration) return;
  dragging = true; bar.setPointerCapture(e.pointerId); dragFrac = fracOf(e); render();
});
bar.addEventListener("pointermove", e => { if (dragging) { dragFrac = fracOf(e); render(); } });
bar.addEventListener("pointerup", e => {
  if (!dragging) return;
  dragging = false;
  act("seek?pos=" + (dragFrac * S.duration).toFixed(2));
});
bar.addEventListener("pointercancel", () => { dragging = false; });

$("ejectbtn").onclick = () => {
  const b = $("ejectbtn");
  if (!armed) {
    armed = true; b.classList.add("armed");
    armTimer = setTimeout(() => { armed = false; b.classList.remove("armed"); }, 3000);
  } else {
    clearTimeout(armTimer); armed = false; b.classList.remove("armed");
    act("eject");
  }
};

poll(); setInterval(poll, 1000); setInterval(render, 250);
</script></body></html>"""


def mpd(cmd):
    with socket.create_connection(MPD, timeout=3) as s:
        r = s.makefile("r", encoding="utf-8", errors="replace", newline="\n")
        r.readline()                                   # greeting: "OK MPD x.y.z"
        s.sendall((cmd + "\n").encode("utf-8"))
        out = {}
        for line in r:
            line = line.rstrip("\n")
            if line == "OK":
                return out
            if line.startswith("ACK"):
                raise RuntimeError(line)
            k, _, v = line.partition(": ")
            out[k] = v
    raise RuntimeError("MPD closed the connection")


def num(x):
    try:
        return float(x)
    except (TypeError, ValueError):
        return None


COVER = "/run/cdplay-work/cover.jpg"


def cover_version():
    try:
        return int(os.stat(COVER).st_mtime)
    except OSError:
        return 0


IDLE_DIR = "/usr/local/share/cdui"
IDLE_TYPES = {"png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg", "webp": "image/webp", "gif": "image/gif", "svg": "image/svg+xml"}


def idle_image():
    for ext, mime in IDLE_TYPES.items():
        path = os.path.join(IDLE_DIR, "idle." + ext)
        if os.path.isfile(path):
            return path, mime
    return None, None


def _status_base():
    st = mpd("status")
    state = st.get("state", "stop")
    song = mpd("currentsong") if state in ("play", "pause") else {}
    loaded = int(st.get("playlistlength", 0))
    loading = subprocess.run(["systemctl", "is-active", "--quiet", "cdplay"]).returncode == 0
    try:
        total = int(open(NTRACKS).read().strip())
    except Exception:
        total = None
    track = song.get("Track") or (str(int(song["Pos"]) + 1) if "Pos" in song else "")
    return {
        "state": state,
        "title": song.get("Title") or song.get("file", ""),
        "artist": song.get("Artist", ""),
        "album": song.get("Album", ""),
        "track": track,
        "loaded": loaded,
        "total": max(total or 0, loaded),
        "loading": loading,
        "elapsed": num(st.get("elapsed")),
        "duration": num(st.get("duration")),
        "cover": cover_version(),
    }


KEEP_PLAYING = False       # True: keep the current track playing while the next one loads
PENDING = None             # playlist position (0-based) we are waiting for
PENDING_T = 0.0
PENDING_MAX = 300          # give up waiting after this many seconds


def ntracks():
    try:
        return int(open(NTRACKS).read().strip())
    except Exception:
        return None


def loader_active():
    return subprocess.run(["systemctl", "is-active", "--quiet", "cdplay"]).returncode == 0


def cancel_pending():
    global PENDING
    PENDING = None


def do_next():
    global PENDING, PENDING_T
    st = mpd("status")
    loaded = int(st.get("playlistlength", 0))
    pos = int(st["song"]) if "song" in st else -1
    cur = PENDING if PENDING is not None else pos
    total = ntracks() or loaded
    nxt = cur + 1
    if pos >= 0 and loader_active() and loaded <= nxt < total:
        PENDING, PENDING_T = nxt, time.time()
        if not KEEP_PLAYING and st.get("state") == "play":
            mpd("pause 1")
    elif PENDING is not None and nxt < loaded:
        PENDING = None
        mpd("play %d" % nxt)
    else:
        PENDING = None
        mpd("next")


def status():
    global PENDING
    d = _status_base()
    if PENDING is not None:
        if d["loaded"] > PENDING:
            mpd("play %d" % PENDING)
            PENDING = None
            d = _status_base()
        elif (not d["loading"]) or time.time() - PENDING_T > PENDING_MAX:
            PENDING = None
    d["pending"] = PENDING + 1 if PENDING is not None else 0
    return d


def act(name, q):
    if name == "toggle":
        cancel_pending()
        s = mpd("status").get("state")
        mpd("pause 1" if s == "play" else "pause 0" if s == "pause" else "play")
    elif name == "next":
        do_next()
    elif name == "prev":
        cancel_pending()
        mpd("previous")
    elif name == "stop":
        cancel_pending()
        mpd("stop")
    elif name == "seek":
        mpd("seekcur %.2f" % float(q["pos"][0]))
    elif name == "eject":
        cancel_pending()
        subprocess.Popen(["sudo", "-n", "/usr/local/bin/cdeject"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        return False
    return True


class H(BaseHTTPRequestHandler):
    def _send(self, code, body, ctype="application/json"):
        b = body if isinstance(body, bytes) else body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        p = urlparse(self.path).path
        if p == "/":
            self._send(200, INDEX, "text/html")
        elif p == "/api/status":
            try:
                self._send(200, json.dumps(status()))
            except Exception as e:
                self._send(503, json.dumps({"error": str(e)}))
        elif p == "/api/cover":
            try:
                data = open(COVER, "rb").read()
                self._send(200, data, "image/png" if data[:4] == b"\x89PNG" else "image/jpeg")
            except OSError:
                self._send(404, "{}")
        elif p == "/api/idle":
            path, mime = idle_image()
            if path:
                self._send(200, open(path, "rb").read(), mime)
            else:
                self._send(404, "{}")
        else:
            self._send(404, "{}")

    def do_POST(self):
        u = urlparse(self.path)
        if not u.path.startswith("/api/"):
            return self._send(404, "{}")
        try:
            ok = act(u.path[5:], parse_qs(u.query))
            self._send(200 if ok else 404, "{}")
        except Exception as e:
            self._send(500, json.dumps({"error": str(e)}))

    def log_message(self, *a):
        pass


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), H).serve_forever()
