#!/usr/bin/env python3
import collections, sys, re, json, struct, time, socket, urllib.request

UA = {"User-Agent": "cd-memory-player/0.1 (personal use)"}

_gai = socket.getaddrinfo


def _ipv4_first(*a, **k):
    return sorted(_gai(*a, **k), key=lambda r: r[0] != socket.AF_INET)


socket.getaddrinfo = _ipv4_first

def parse_toc(text):
    tracks = []
    for line in text.splitlines():
        m = re.match(r"\s*(\d+)\.\s+(\d+)\s+\[[^\]]*\]\s+(\d+)\s+\[", line)
        if m:
            tracks.append((int(m[1]), int(m[2]), int(m[3])))
    return tracks

def credit(ac):
    return "".join(a.get("name", "") + a.get("joinphrase", "") for a in (ac or []))

def lookup():
    tracks = parse_toc(sys.stdin.read())
    if not tracks:
        print("{}"); return
    secs = [t[1] / 75 for t in tracks]
    leadout = tracks[-1][2] + tracks[-1][1] + 150
    toc = "+".join(str(x) for x in [tracks[0][0], tracks[-1][0], leadout] + [t[2] + 150 for t in tracks])
    url = f"https://musicbrainz.org/ws/2/discid/-?toc={toc}&fmt=json&inc=recordings+artist-credits+release-groups&cdstubs=no"
    data = None
    for attempt in range(3):
        try:
            data = json.load(urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=3))
            break
        except Exception:
            time.sleep(1)
    if data is None:
        print("{}"); return
    cands = []
    for r in data.get("releases", []):
        rg = r.get("release-group") or {}
        album_key = rg.get("id") or (r["title"].strip().lower(), credit(r.get("artist-credit")).strip().lower())
        date = r.get("date") or ""
        for med in r.get("media", []):
            tr = med.get("tracks", [])
            if len(tr) != len(tracks):
                continue
            diffs = [abs((t.get("length") or 10**9) / 1000 - s) for t, s in zip(tr, secs)]
            cands.append((max(diffs), album_key, date, r, tr))
    if not cands:
        print("{}"); return
    cands.sort(key=lambda c: c[0])
    best_diff = cands[0][0]
    if best_diff >= 10:
        print("{}"); return
    near = [c for c in cands if c[0] < 3 * max(best_diff, 1)]
    groups = collections.Counter(c[1] for c in near).most_common()
    top_key, top_n = groups[0]
    if len(groups) > 1 and groups[1][1] * 2 > top_n:      # another album is about as well supported
        print("{}"); return
    top = [c for c in near if c[1] == top_key]

    def pref(c):
        rg_title = ((c[3].get("release-group") or {}).get("title") or "").strip().lower()
        return (round(c[0], 1), 0 if c[3]["title"].strip().lower() == rg_title else 1, -len(c[2]), c[2])

    top.sort(key=pref)
    best = top[0]
    r, tr = best[3], best[4]
    rel_artist = credit(r.get("artist-credit"))
    out = {"mbid": r.get("id", ""), "rgid": (r.get("release-group") or {}).get("id", ""), "album": r["title"], "date": (r.get("date") or "")[:4],
           "tracks": [{"title": t["title"], "artist": credit(t.get("artist-credit")) or rel_artist} for t in tr]}
    print(json.dumps(out))

def sub(tag, text):
    b = text.encode("utf-8") + b"\0"
    return tag + struct.pack("<I", len(b)) + b + (b"\0" if len(b) % 2 else b"")

def header():
    meta_file, n, sectors, out = sys.argv[2:6]
    n, sectors = int(n), int(sectors)
    try:
        meta = json.load(open(meta_file, encoding="utf-8"))
    except Exception:
        meta = {}
    if meta.get("tracks") and n <= len(meta["tracks"]):
        t = meta["tracks"][n - 1]
        tags = {b"INAM": t["title"], b"IART": t["artist"], b"IPRD": meta["album"]}
        if meta.get("date"):
            tags[b"ICRD"] = meta["date"]
    else:
        tags = {b"INAM": "Track %02d" % n, b"IPRD": "Audio CD"}
    tags[b"ITRK"] = str(n)
    info = b"INFO" + b"".join(sub(k, v) for k, v in tags.items() if v)
    lst = b"LIST" + struct.pack("<I", len(info)) + info
    nbytes = sectors * 2352
    fmt = b"fmt " + struct.pack("<IHHIIHH", 16, 1, 2, 44100, 176400, 4, 16)
    body = b"WAVE" + fmt + lst + b"data" + struct.pack("<I", nbytes)
    hdr = b"RIFF" + struct.pack("<I", len(body) + nbytes) + body
    with open(out, "wb") as f:
        f.write(hdr)
        f.truncate(len(hdr) + nbytes)
    print(len(hdr))

def cover():
    meta_file, out = sys.argv[2:4]
    try:
        meta = json.load(open(meta_file, encoding="utf-8"))
    except Exception:
        meta = {}
    for kind, key in (("release", "mbid"), ("release-group", "rgid")):
        if not meta.get(key):
            continue
        try:
            url = "https://coverartarchive.org/%s/%s/front-500" % (kind, meta[key])
            with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=10) as r:
                data = r.read()
            if data[:2] == b"\xff\xd8" or data[:4] == b"\x89PNG":
                open(out, "wb").write(data)
                print("ok"); return
        except Exception:
            pass
    print("none")

{"lookup": lookup, "header": header, "cover": cover}[sys.argv[1]]()
